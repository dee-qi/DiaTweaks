#!/usr/bin/env python3
"""Validate catalogs and compile one deterministic resource into the dylib."""
import json, pathlib, re, sys
root = pathlib.Path(__file__).resolve().parent.parent
entries = {}
index = {}
def unique(pairs):
    d = {}
    for k, v in pairs:
        if k in d: raise ValueError(f'duplicate key: {k}')
        d[k] = v
    return d
languages = json.loads((root / 'locales/languages.json').read_text(), object_pairs_hook=unique)
assert languages[0]['id'] == 'en'
assert len({x['id'] for x in languages}) == len(languages)
for language in languages[1:]:
    locale = language['id']
    seen = set()
    for path in sorted((root / 'locales' / locale).glob('*.json')):
        for key, entry in json.loads(path.read_text(), object_pairs_hook=unique).items():
            if key in seen: raise ValueError(f'duplicate ID: {key}')
            seen.add(key)
            assert entry['en'] and entry[locale] and entry['contexts'], key
            pattern = r'%(?:\d+\$)?[-+ #0]*(?:\d+|\*)?(?:\.(?:\d+|\*))?(?:hh|ll|[hljztL])?[@diuoxXfFeEgGaAcCsSp%]'
            assert re.findall(pattern, entry['en']) == re.findall(pattern, entry[locale]), f'format mismatch: {key}'
            assert sorted(re.findall(r'\$[A-Za-z0-9]+\$?', entry['en'])) == sorted(re.findall(r'\$[A-Za-z0-9]+\$?', entry[locale])), f'placeholder mismatch: {key}'
            if entry.get('pattern'):
                compiled = re.compile(entry['pattern'])
                assert entry['pattern'].startswith('^') and entry['pattern'].endswith('$') and entry.get('prefix'), key
                assert compiled.groups == len(re.findall(r'%[0-9]+\$@', entry['en'])), key
            for context in entry['contexts']:
                pair = locale, context, entry['en']
                assert pair not in index or index[pair] == entry[locale], f'ambiguous source: {pair}'
                index[pair] = entry[locale]
            if key in entries:
                assert entries[key]['en'] == entry['en'] and entries[key]['contexts'] == entry['contexts'], key
                entries[key][locale] = entry[locale]
            else: entries[key] = entry
    assert seen, f'empty catalog: {locale}'
payload = json.dumps({'languages': languages, 'messages': entries}, ensure_ascii=False, sort_keys=True, separators=(',', ':')).encode()
out = '/* Generated by scripts/build-localizations; do not edit. */\nstatic const unsigned char DPCatalogBytes[] = {\n' + ','.join(map(str, payload)) + '\n};\n'
if '--check' not in sys.argv:
    dest = root / 'build/Catalog.inc'
    dest.parent.mkdir(exist_ok=True)
    if not dest.exists() or dest.read_text() != out: dest.write_text(out)
if '--check' in sys.argv and (root / 'build/patches.json').exists():
    sources = {entry['en'] for entry in entries.values()}
    for patch in json.loads((root / 'build/patches.json').read_text())['patches']:
        for field in ('title', 'detail', 'section'):
            assert not patch.get(field) or patch[field] in sources, f"missing tweak translation: {patch['key']}.{field}"
print(f'Validated {len(entries)} localized messages')

# Custom tuning rows are outside the patch metadata manifest. Check their actual
# factory arguments too, so a translated patch title cannot hide missing options.
if '--check' in sys.argv:
    tweak_sources = {e['en'] for e in entries.values() if 'tweaks' in e['contexts']}
    factories = r'(?:DPSliderRow|DPSwitchRow|DPSizeSlider|DPPeekSlider|DPPeekSwitch)'
    for path in (root / 'src/dylib/Patches').rglob('*.m'):
        for source in re.findall(factories + r'\(@"([^"\n]+)"', path.read_text()):
            assert source in tweak_sources, f'missing custom control translation: {path}: {source}'
